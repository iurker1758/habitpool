# Copy to .env (same directory) and adjust. .env is gitignored; never commit it.
# Real environment variables override anything set here.

# Async SQLAlchemy URL for the app and Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/habitpool

# Cloudflare Access (deployed only). Leave both unset for local dev — the API
# then runs with auth disabled. Setting only one refuses to start.
# ACCESS_TEAM_DOMAIN=myteam
# ACCESS_AUD is the AUD tag of the Access application on the *frontend* (Pages)
# hostname: the SPA reaches the API through the same-origin Pages proxy, which
# forwards the JWT Access minted for that app. The tunnel hostname itself
# carries no Access application; unsigned requests to it are refused here.
# ACCESS_AUD=<Application Audience tag from the Access app's settings>
